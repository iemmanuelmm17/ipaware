# ---------------------------------------------------------------------------
# IPAware Console - default configuration (safe to commit: NO real secrets here)
# Edit the allowlist below before exposing this site to a network.
# Put real secrets / overrides in .env.local (git-ignored) or use the UI field.
# ---------------------------------------------------------------------------
APP_NAME="IPAware Console"
APP_MODE=auto
APP_DEBUG=false
TIMEZONE=Asia/Manila

# Replace these RFC 5737 documentation addresses with YOUR public IP(s).
# Example: ADMIN_ALLOWED_IPS=112.198.77.21,112.198.77.22/32,2001:db8:1::/48
ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.25,2001:db8::/32
REQUIRE_PUBLIC_IP=true
DEV_ALLOW_LOCALHOST=true
TRUSTED_PROXIES=
CLIENT_IP_HEADER=

# Leave empty to run the built-in DEMO data. Set to your server to go live.
API_BASE_URL=
API_KEY=
API_VERIFY_TLS=true
API_TIMEOUT=12
AUTH_SCHEME=Bearer
ENDPOINT_DECISIONS=/ipaware/decisions
ENDPOINT_IP=/ipaware/ip
ENDPOINT_BLOCK=/ipaware/firewall/block
ENDPOINT_UNBLOCK=/ipaware/firewall/unblock
ENDPOINT_ALLOWLIST=/ipaware/allowed_ips
WRITE_PARAMS_MODE=query
ALLOWLIST_DELETE_METHOD=DELETE
ALLOW_RUNTIME_SERVER_OVERRIDE=true

SSE_ENABLED=true
SSE_POLL_SECONDS=8
SSE_MAX_SECONDS=300
MIN_AUTO_REFRESH=10
MAX_EVENTS=1500
DATA_DIR=./data
DEMO_SEED=1337
