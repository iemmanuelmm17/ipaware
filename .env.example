# ---------------------------------------------------------------------------
# IPAware Console - configuration
# Copy this file to .env and edit. Put REAL secrets in .env.local (git-ignored)
# or type the API key in the web UI (stored only in the PHP session).
# ---------------------------------------------------------------------------

APP_NAME="IPAware Console"
APP_MODE=auto                 # auto | demo | live. auto = live when API_BASE_URL is set, otherwise demo.
APP_DEBUG=false
TIMEZONE=Asia/Manila

# ---------------------------------------------------------------------------
# ACCESS CONTROL (the important bit)
# Only these IPs may open ANY page, API, asset, stream or export.
# Use YOUR real public IPv4/IPv6 addresses or CIDR ranges, comma separated.
# The values below are documentation addresses (RFC 5737) - REPLACE THEM.
# An empty list = deny everybody (fail closed) except the local dev bypass.
# ---------------------------------------------------------------------------
ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.25,2001:db8::/32
REQUIRE_PUBLIC_IP=true        # reject private/reserved source IPs even if listed
DEV_ALLOW_LOCALHOST=true      # needed for http://localhost on your own PC; set false in production

# Only trust forwarded headers when the direct peer is a proxy you control.
TRUSTED_PROXIES=
CLIENT_IP_HEADER=             # e.g. X-Forwarded-For, CF-Connecting-IP, X-Real-IP

# ---------------------------------------------------------------------------
# UPSTREAM API (the service your curl examples talk to)
# Base may be "https://myserver.example.com" or "https://myserver.example.com/ipaware"
# (if it already includes /ipaware, set the ENDPOINT_* values to /decisions etc.)
# ---------------------------------------------------------------------------
API_BASE_URL=
API_KEY=                      # optional fallback; the UI field is preferred
API_VERIFY_TLS=true           # set false ONLY for a local self-signed cert
API_TIMEOUT=12
AUTH_SCHEME=Bearer            # Bearer | ApiKey | raw (raw sends the key with no prefix)

ENDPOINT_DECISIONS=/ipaware/decisions
ENDPOINT_IP=/ipaware/ip
ENDPOINT_BLOCK=/ipaware/firewall/block
ENDPOINT_UNBLOCK=/ipaware/firewall/unblock
ENDPOINT_ALLOWLIST=/ipaware/allowed_ips

# Query parameters used for write calls (matches your curl examples).
WRITE_PARAMS_MODE=query       # query | json (json sends a JSON body instead)
ALLOWLIST_DELETE_METHOD=DELETE
ALLOW_RUNTIME_SERVER_OVERRIDE=true

# ---------------------------------------------------------------------------
# LIVE EVENTS / POLLING
# ---------------------------------------------------------------------------
SSE_ENABLED=true
SSE_POLL_SECONDS=8            # how often the server re-reads decisions/allowlist
SSE_MAX_SECONDS=300           # stream is recycled after this; browser reconnects
MIN_AUTO_REFRESH=10           # minimum allowed auto-refresh interval (seconds)
MAX_EVENTS=1500
DATA_DIR=./data
DEMO_SEED=1337
